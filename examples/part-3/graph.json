  "nodes": [
    {
      "id": "method:methods_axisymmetric_coil_section",
      "layer": 2,
      "kind": "component",
      "title": "Axisymmetric rectangular winding section",
      "description": "Draw a radial/axial winding rectangle at positive radius, place a winding label and model the full revolution about r=0. The graphical preview is a generic cross-section; its dimensions are explicit parameters, not copied from every cited device.",
      "parameters": [
        {
          "name": "inner_radius",
          "unit": "length",
          "description": "Radial position of the winding inner surface; nonnegative."
        },
        {
          "name": "outer_radius",
          "unit": "length",
          "description": "Must exceed inner radius."
        },
        {
          "name": "axial_length",
          "unit": "length",
          "description": "Length of the winding along z."
        }
      ],
      "inputs": [
        "Winding dimensions and axis convention"
      ],
      "outputs": [
        "Closed coil section and label"
      ],
      "constraints": [
        "Use r/z coordinates and r >= 0.",
        "An axisymmetric winding represents circumferential current, not a planar extrusion."
      ],
      "capabilities": [
        "axisymmetric_magnetics"
      ],
      "source_ids": [
        "aircore",
        "blockedimpedance",
        "blockedimpedance1khz",
        "coilgun",
        "magneticstutorial",
        "rotersexample",
        "team28",
        "woofer"
      ],
      "verification": {
        "status": "numerically_checked",
        "report": "verification/official_reproductions.json",
        "reports": [
          "verification/official_reproductions.json"
        ],
        "case_ids": [
