    {
      "id": "method:methods_biased_incremental_inductance",
      "layer": 2,
      "kind": "method",
      "title": "Finite-difference inductance about magnet bias",
      "description": "For the woofer example, solve the same coil position with zero and nonzero current and divide the linkage difference by the current difference. This removes fixed magnet linkage from the estimated self-inductance.",
      "parameters": [
        {
          "name": "delta_current",
          "unit": "A",
          "description": "Chosen finite perturbation about the magnet-established operating point."
        }
      ],
      "inputs": [
        "Two matching position snapshots and their current/linkage pairs"
      ],
      "outputs": [
        "Finite-difference incremental inductance estimate"
      ],
      "constraints": [
        "The perturbation must be checked for adequacy in nonlinear steel.",
        "Total linkage divided by coil current includes magnet bias and is not the desired incremental inductance."
      ],
      "capabilities": [
        "biased_magnetostatics"
      ],
      "source_ids": [
        "woofer"
      ],
      "verification": {
        "status": "documented",
        "note": "Procedure curated from the cited official FEMM example(s); this library entry has not been numerically rerun."
      },
      "tags": [
        "solution",
        "biased_incremental_inductance"
      ],
      "version": 1,
      "source_versions": {
        "woofer": "c6bddc1d39273db97c5dc1c0b6d46fbfb6366e655f065777f2a8f96ec38e3590"
      }
    },
    {
      "id": "method:methods_linear_flux_inductance",
      "layer": 2,
      "kind": "method",
      "title": "Inductance from circuit flux linkage",
      "description": "Read the winding current and total flux linkage from circuit properties and compute L = linkage/current for the explicitly linear single-source regime.",
      "parameters": [
        {
          "name": "current",
          "unit": "A",
          "description": "Nonzero winding current used for linkage/current."
        }
      ],
      "inputs": [
        "Solved linear model and circuit name"
      ],
      "outputs": [
        "Self-inductance in H and winding quantities"
      ],
      "constraints": [
        "A permanent-magnet bias or other independently excited coil invalidates the simple quotient for self-inductance.",
        "Saturation requires a stated apparent or incremental definition."
      ],
      "capabilities": [
        "circuit_postprocessing",
        "linear_magnetostatics"
      ],
      "source_ids": [
        "aircore",
        "inductanceexample",
        "magneticstutorial"
      ],
      "verification": {
        "status": "documented",
        "note": "Procedure curated from the cited official FEMM example(s); this library entry has not been numerically rerun."
      },
      "tags": [
        "solution",
        "linear_flux_inductance"
      ],
      "version": 1,
